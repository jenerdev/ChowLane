# Each app (landing, console, rider, customer, platform) reads these from its own apps/<app>/.env.local.
# Local Docker stack: `pnpm db:start && pnpm db:env` writes them for you.
# Hosted project: copy the Project URL + anon (publishable) key from Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# landing + console only, server-side (signup, invites, rider passwords). Never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
